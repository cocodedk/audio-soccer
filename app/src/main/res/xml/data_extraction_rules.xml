<?xml version="1.0" encoding="utf-8"?>
<!-- The app keeps two settings (the language and the speech engine) and the level records, and wants them on this phone only: nothing goes to a cloud backup
     or to a new phone. From Android 12, android:allowBackup is deprecated and covers cloud backup alone, so these rules say it
     for cloud backup and device transfer separately (backup_rules.xml says it for Android 11 and earlier). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
